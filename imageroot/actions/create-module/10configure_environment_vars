# Generate base64 like base64:PIrmlUsSBDH89CELqbIhJP9jhqhADGSttMOPhUPpunA=
def generate_base64_app_key():
    # Laravel needs base64 of exactly 32 random bytes for AES-256
    import base64
    return "base64:" + base64.b64encode(os.urandom(32)).decode()

APP_KEY = generate_base64_app_key()

